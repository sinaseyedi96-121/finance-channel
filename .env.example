# Copy this file to .env for local testing (never commit the real .env).
# In GitHub Actions these are set as repo Secrets instead — see README.

# ---- Required ----
# DeepSeek key (OpenAI-compatible). Same var name as crypto-market-channel.
DEEPSEEK_KEY=your_deepseek_api_key

# ---- Telegram (provide when the channel/bot is ready) ----
# Use the NUMERIC channel id (e.g. -1001234567890), not @username.
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL=-1001234567890

# ---- Optional data sources (pipeline degrades gracefully if unset) ----
FINNHUB_KEY=your_finnhub_free_key
FRED_API_KEY=your_free_fred_key          # unset -> keyless FRED CSV fallback is used
EIA_API_KEY=your_free_eia_key            # unset -> EIA fallback skipped (FRED covers oil)

# SEC EDGAR requires a descriptive User-Agent with contact info on every request.
SEC_USER_AGENT=your-name your-email@example.com
